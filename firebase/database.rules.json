{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "bans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && root.child('admins').child($uid).val() !== true",
        ".validate": "newData.isString()"
      }
    },
    "announcement": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['text', 'at']) && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('at').isNumber()"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).val() === true && !newData.child('username').exists()))",
        "username": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('usernames').child(newData.val()).val() === auth.uid"
        },
        "$other": { ".validate": false }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (root.child('admins').child(auth.uid).val() === true && !newData.exists()))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/)"
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && !root.child('bans').child(auth.uid).exists() && (!newData.exists() || newData.val() === root.child('users').child(auth.uid).child('username').val())) || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$f": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $f) && (!newData.exists() || (auth.uid === $uid && root.child('requests').child($uid).child($f).exists()) || (auth.uid === $f && root.child('requests').child($f).child($uid).exists()))",
          ".validate": "newData.isString()"
        }
      }
    },
    "presence": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && !root.child('bans').child(auth.uid).exists() && root.child('friends').child($to).child($from).exists() && (!newData.exists() || newData.isString())) || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "vibe": {
      "$host": {
        ".read": "auth != null && auth.uid === $host",
        "$guest": {
          ".read": "auth != null && auth.uid === $guest",
          ".write": "auth != null && (auth.uid === $host || (auth.uid === $guest && !root.child('bans').child(auth.uid).exists() && root.child('friends').child($host).child($guest).exists() && (!newData.exists() || newData.child('ok').val() === false)))"
        }
      }
    },
    "chats": {
      "$chat": {
        ".read": "auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid)) && query.orderByChild === 'at' && query.startAt >= now - 86400000",
        ".indexOn": ["at"],
        "$msg": {
          ".write": "auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid)) && ((!data.exists() && newData.child('from').val() === auth.uid && !root.child('bans').child(auth.uid).exists() && root.child('friends').child(auth.uid).child($chat.replace(auth.uid, '').replace('_', '')).exists()) || (data.exists() && !newData.exists() && (data.child('from').val() === auth.uid || data.child('at').val() < now - 86400000)) || (!data.exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['from', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('at').val() === now"
        }
      }
    },
    "chatAt": {
      "$chat": {
        ".read": "auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid))",
        ".indexOn": ".value",
        "$msg": {
          ".write": "auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid)) && ((!data.exists() && newData.val() === now && root.child('friends').child(auth.uid).child($chat.replace(auth.uid, '').replace('_', '')).exists()) || (data.exists() && !newData.exists() && (data.val() < now - 86400000 || root.child('chats').child($chat).child($msg).child('from').val() === auth.uid)) || (!data.exists() && !newData.exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "tunnel": {
      "$host": {
        ".read": "auth != null && auth.uid === $host",
        ".write": "auth != null && auth.uid === $host",
        "$conn": {
          ".read": "auth != null && data.child('guest').val() === auth.uid",
          ".write": "auth != null && (data.exists() ? data.child('guest').val() === auth.uid : newData.child('guest').val() === auth.uid) && !root.child('bans').child(auth.uid).exists() && (root.child('friends').child($host).child(auth.uid).exists() || root.child('admins').child(auth.uid).val() === true)",
          "up":   { "$m": { ".validate": "newData.isString() && newData.val().length < 500000" } },
          "down": { "$m": { ".validate": "newData.isString() && newData.val().length < 500000" } }
        }
      }
    }
  }
}
